# ============================================
# Hyprland Resume Service
# ============================================
# Resumes Hyprland AFTER the NVIDIA driver resumes to prevent
# application freezes and crashes on resume.
#
# Installation:
#   sudo ln -sf ~/.config/hypr/systemd/hyprland-resume.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable hyprland-resume.service

[Unit]
Description=Resume Hyprland after NVIDIA driver
After=systemd-suspend.service
After=systemd-hibernate.service
After=nvidia-resume.service

[Service]
Type=oneshot
ExecStart=/home/ice/.config/hypr/scripts/suspend-hyprland.sh resume

[Install]
WantedBy=systemd-suspend.service
WantedBy=systemd-hibernate.service
