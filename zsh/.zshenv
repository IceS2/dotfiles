# ╔═══════════════════════════════════════════════════════════╗
# ║                       ~/.zshenv                           ║
# ║  Loaded for ALL zsh instances (interactive + scripts)    ║
# ║  Keep MINIMAL - only critical configuration here          ║
# ╚═══════════════════════════════════════════════════════════╝

# Set ZDOTDIR to use XDG Base Directory standard
export ZDOTDIR=$HOME/.config/zsh

# Note: All other configuration (PATH, aliases, etc.)
# is in $ZDOTDIR/.zshrc and its modular components
